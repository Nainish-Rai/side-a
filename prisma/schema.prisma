generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DeviceLibraryState {
  deviceId       String   @id
  likedTracks    Json
  savedAlbums    Json
  recentlyPlayed Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
